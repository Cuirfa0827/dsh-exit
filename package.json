{
  "name": "dsh-sidebar-exit",
  "version": "0.1.0",
  "description": "DeepSeek Harness 退出插件：侧边栏底部「退出」按钮，一键优雅关闭 DSH 服务进程；可选支持关闭最后一个窗口时自动退出服务。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "exit",
    "shutdown",
    "sidebar"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "macapp",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "dsh.plugin.json"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7 <5.0.0",
    "react": "^18.2.0"
  },
  "license": "MIT"
}
